# FinSight configuration. Copy to .env and adjust; every setting is optional.
#   cp .env.example .env

# --- Option 1: local (default) --------------------------------------------------------------
# Where bronze/silver/gold Parquet, run manifests, and the DuckDB catalog are written.
FINSIGHT_DATA_DIR=./data
# Parallel symbol downloads and retries for transient provider errors.
FINSIGHT_MAX_WORKERS=4
FINSIGHT_MAX_RETRIES=3

# --- Store data in S3 / MinIO instead of ./data (requires `pip install "finsight[s3]"`) ------
# FINSIGHT_STORAGE=s3
# FINSIGHT_S3_BUCKET=finsight
# FINSIGHT_S3_PREFIX=
# FINSIGHT_S3_ENDPOINT_URL=http://localhost:9000   # omit for AWS S3
# FINSIGHT_S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Option 2: Airflow platform (docker compose) ---------------------------------------------
# The compose stack always stores data in its MinIO container; these set its credentials.
MINIO_ROOT_USER=finsight
MINIO_ROOT_PASSWORD=finsight-secret
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
# Change for anything beyond local use:
# AIRFLOW_JWT_SECRET=
# AIRFLOW_FERNET_KEY=
# Universe refreshed by the scheduled finsight_daily DAG.
# FINSIGHT_DAILY_UNIVERSE=dow30

# --- Optional Snowflake sink (requires `pip install "finsight[snowflake]"`) ------------------
# SNOWFLAKE_ACCOUNT=orgname-accountname
# SNOWFLAKE_USER=
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_WAREHOUSE=COMPUTE_WH
# SNOWFLAKE_DATABASE=FINSIGHT
# SNOWFLAKE_SCHEMA=MARKET_DATA
# SNOWFLAKE_ROLE=

# --- Optional Spark engine outside Docker (requires `pip install "finsight[spark]"`, Java 17/21)
# FINSIGHT_SPARK_MASTER=local[*]
